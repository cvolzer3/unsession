{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unsession",
  "account_id": "9bbf4e4369014eae4329711aced8e0ae",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [
    { "pattern": "unsession.dev", "custom_domain": true },
    { "pattern": "www.unsession.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true },

  // Run the worker near D1 instead of near the visitor. Admin pages issue
  // 10–25 sequential D1 queries; placed next to the database each one is
  // ~1ms instead of a cross-region round trip.
  "placement": { "mode": "smart" },

  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "unsession-files"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unsession-db",
      "database_id": "4002bb95-1ebd-4aa8-8164-0b83acaeb86b",
      "migrations_dir": "migrations"
    }
  ],

  // Email sending — unsession.dev onboarded to Email Service 2026-08-12 (Workers
  // Paid active). Sandbox orgs are force-simulated in src/lib/email.ts.
  "send_email": [{ "name": "EMAIL" }],

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "vars": {
    // Single source for absolute URLs in emails and magic links. Must match the
    // origin the worker is actually reachable on — switch to https://unsession.dev
    // once the custom domain route is attached.
    "APP_ORIGIN": "https://unsession.dev",
    "EMAIL_FROM": "no-reply@unsession.dev",
    "EMAIL_ENABLED": "1"
  }
}
